window open 100,100 to 800,800, "Example", "Example"

DRAW TRIANGLE 150,150, 80, 80,270,30, "Example" 
//Bogen1 auf Window
draw set "highcolor",255,0,0,"Example"
draw set true, "HighSolidFill"
draw arc 150,150, 80, 80,270,30, "Example"

draw set false, "HighSolidFill"
draw arc 250,250, 250, 250, 85,30,"Example"

canvas 400,400 to 800,800, "DRAWTRIANGLE","Example"
draw arc 125,125, 50, 50,270,180, "DRAWTRIANGLE"
draw set true, "HighSolidFill"
draw arc 50,50, 18, 18,180,30, "DRAWTRIANGLE"
sleep 7
window close "Example"
window open 100,100 to 800,800, "Example", "Example"
draw set true, "HighSolidFill"
draw arc 150,150, 80, 180, 270,30, "Example"
sleep 7
window close "Example"
